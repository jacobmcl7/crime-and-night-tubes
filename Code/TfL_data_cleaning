# this R script imports and cleans the TfL ridership data

#######################################################################################

# load libraries
library(readxl)
library(writexl)
library(tidyverse)

# set working directory
setwd("~/Economics/Papers (WIP)/Crime and night tubes EXTRA DATA/")

#######################################################################################

# import and process the first one
data <- as.data.frame(read.csv("TfL data/160819-20.csv"))

# remove rows up until the one where the first column is "Count of Taps"
data <- data[which(data[,1] == "Count of Taps"):nrow(data), ]
# remove empty rows
data <- data[-which(data$X == "" | data$X.1 == ""), ]
# remove empty columns (i.e. ones with only NAs) - i.e. keep the first 7
data <- data[, 1:7]
# set first row as column names, then remove it from the data frame
colnames(data) <- data[1, ]
data <- data[-1, ]
# reorganise the timing convention, and add a week variable
data <- data %>%
    mutate(`Traffic Date Sort 15 Minute` = as.numeric(`Traffic Date Sort 15 Minute`)) %>%
    mutate(Night = ifelse((`Day Of Week` == "Friday" | (`Day Of Week` == "Saturday" & `Traffic Date Sort 15 Minute` <= 10)), 1, 2)) %>%
    mutate('Traffic Date 15 Minute' = substr(`Traffic Date 15 Minute`, 1, 5)) %>%
    mutate(Week = "160812-13")
# remove irrelevant variables
data <- data %>%
    select(-c(`Traffic Date Sort 15 Minute`, `Day Of Week`, `Traffic Date`))


# now make a loop to import and process the rest of the files, and bind them together

# collect all files in the directory, other than the first and the last one (which is an overall count)
file_list <- list.files(path = "TfL data/", pattern = "*.csv")[-c(1, 2, which(list.files(path = "TfL data/", pattern = "*.csv") == "170114-15.csv"), which(list.files(path = "TfL data/", pattern = "*.csv") == "NT Demand to End 2017.csv"))]
# THIS MIDDLE ONE IS STRANGE - WORK OUT WHAT IT IS!
# we also omit the first one because it is a duplicate of the second

# loop over them and process them in the same way as the first one, then bind them together
for (file in file_list) {
    # import the data
    temp_data <- as.data.frame(read.csv(paste0("TfL data/", file)))
    
    # remove rows up until the one where the first column is "Count of Taps"
    temp_data <- temp_data[which(temp_data[,1] == "Count of Taps"):nrow(temp_data), ]
    # remove empty rows
    temp_data <- temp_data[-which(temp_data$X == "" | temp_data$X.1 == ""), ]
    # remove empty columns (i.e. ones with only NAs) - i.e. keep the first 7
    temp_data <- temp_data[, 1:7]
    # set first row as column names, then remove it from the data frame
    colnames(temp_data) <- temp_data[1, ]
    temp_data <- temp_data[-1, ]
    # reorganise the timing convention, and add a week variable
    temp_data <- temp_data %>%
        mutate(`Traffic Date Sort 15 Minute` = as.numeric(`Traffic Date Sort 15 Minute`)) %>%
        mutate(Night = ifelse((`Day Of Week` == "Friday" | (`Day Of Week` == "Saturday" & `Traffic Date Sort 15 Minute` <= 10)), 1, 2)) %>%
        mutate('Traffic Date 15 Minute' = substr(`Traffic Date 15 Minute`, 1, 5)) %>%
        mutate(Week = substr(file, 1, nchar(file)-4))
    # remove irrelevant variables
    temp_data <- temp_data %>%
        select(-c(`Traffic Date Sort 15 Minute`, `Day Of Week`, `Traffic Date`))
    
    # bind to the main data frame
    data <- rbind(data, temp_data)
}

# now some final cleaning
# convert the count variable to numeric
data$`Count of Taps` <- as.numeric(data$`Count of Taps`)
# sort in terms of week, night, station, traffic date 15 minute, and transaction type
data <- data %>%
    arrange(Week, Night, `Travel Location`, `Traffic Date 15 Minute`, `Transaction Type`)
# drop the row names
rownames(data) <- NULL


# save the cleaned data as a csv file
write.csv(data, "TfL_ridership_data_cleaned.csv", row.names = FALSE)



#######################################################################

# now get the total number of entries and exits (summed) for each station and month combo

station_monthly <- data %>%
    group_by(`Travel Location`, Week) %>%
    summarise(Total_Taps = sum(`Count of Taps`))

# now do some manual cleaning of the ridership data to match the naming conventions of the final dataset in the analysis file
# from Claude, but checked (was originally done in the analysis file, side by side with the ATT data)
station_name_mapping <- c(
  # LU suffix removals / punctuation fixes
  "Balham LU"                    = "Balham",
  "Bethnal Green LU"             = "Bethnal Green",
  "Brixton LU"                   = "Brixton",
  "Charing Cross LU"             = "Charing Cross",
  "Euston LU"                    = "Euston",
  "Finsbury Park LU"             = "Finsbury Park",
  "Liverpool Street LU"          = "Liverpool Street",
  "London Bridge LU"             = "London Bridge",
  "Vauxhall LU"                  = "Vauxhall",
  "Victoria LU"                  = "Victoria",
  "West Hampstead LU"            = "West Hampstead",
  "Heathrow Terminal 5 LU"       = "Heathrow Terminal 5",
  "Heathrow Terminals 123 LU"    = "Heathrow Terminals 1-2-3",

  # Spelling / punctuation differences
  "Earls Court"                  = "Earl's Court",
  "Shepherds Bush LU"            = "Shepherd's Bush",
  "St Johns Wood"                = "St. John's Wood",
  "St Pauls"                     = "St. Paul's",
  "Totteridge"                   = "Totteridge & Whetstone",
  "Hammersmith D&P"              = "Hammersmith (Dist&Picc Line)",

  # Multiple ridership entries → one ATT entry
  "Canary Wharf LU (E1)"         = "Canary Wharf",
  "Canary Wharf LU (E2)"         = "Canary Wharf",
  "Kings Cross LU (North)"       = "King's Cross St. Pancras",
  "Kings Cross LU (Tube)"        = "King's Cross St. Pancras",
  "Kings Cross LU (Western)"     = "King's Cross St. Pancras",
  "Waterloo LU (Jubilee)"        = "Waterloo"
)

# Apply the mapping to the original variable in the ridership data
station_monthly <- station_monthly %>%
  mutate(`Travel Location` = dplyr::recode(`Travel Location`, !!!station_name_mapping))

# the only one from the ridership data that couldn't be matched was Heathrow Terminal 4 - just drop this at the right time

# now clean the week variable to get it to match the period variable in the major dataset
# extract the third and fourth character (corresponding to the month), and convert to numeric
station_monthly <- station_monthly %>%
  mutate(month = as.numeric(substr(Week, 3, 4))) %>%
  # now convert to period variable, where period is month + 24 (i.e. month 1 of 2017 is period 25), and then group into two month periods to match the main dataset
  mutate(period = month + 24) 

# now get the average of Total_Taps for each station and period
station_monthly <- station_monthly %>%
  group_by(`Travel Location`, period) %>%
  summarise(monthly_avg_taps = mean(Total_Taps)) %>%
  ungroup()

# finally, rename travel location to station to match the main dataset
station_monthly <- station_monthly %>%
  rename(station = `Travel Location`)

# save this as a csv file
write.csv(station_monthly, "TfL_station_monthly_ridership.csv", row.names = FALSE)


# also collect up the weekly counts

station_weekly <- data %>%
    group_by(`Travel Location`, Week) %>%
    summarise(Total_Taps = sum(`Count of Taps`)) %>%
    mutate(`Travel Location` = dplyr::recode(`Travel Location`, !!!station_name_mapping)) %>%

    # now remove all observations in 2016, where the first two characters of week are 16
    filter(substr(Week, 1, 2) == "17") %>%

    # now collect the month and the date variable
    mutate(month = as.numeric(substr(Week, 3, 4))) %>%
    mutate(date = as.numeric(substr(Week, 5, 6))) %>%

    # finally remove, rename variables and export the data
    select(-Week) %>%
    rename(station = `Travel Location`) %>%
    write.csv("TfL_station_weekly_ridership.csv", row.names = FALSE)